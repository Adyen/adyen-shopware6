{% sw_extends '@Storefront/storefront/component/checkout/offcanvas-cart.html.twig' %}
{% set adyenFrontendData = page.extensions[constant('Adyen\\Shopware\\Subscriber\\StorefrontSubscriber::ADYEN_DATA_EXTENSION_ID')] %}

{% block component_offcanvas_cart_actions_promotion_form %}
    {{ parent() }}

    {% if adyenFrontendData and adyenFrontendData.giftcards %}
        <a href="{{ adyenFrontendData.shoppingCartPageUrl }}" class="btn btn-xs btn-outline-info float-right mb-3">
            &plus; {{ "adyen.giftcard.addGiftcards" | trans }}
        </a>
        <div class="clearfix"></div>
    {% endif %}
{% endblock %}

{% block component_offcanvas_cart_actions_checkout %}
    {{ parent() }}

    {% if adyenFrontendData and adyenFrontendData.expressCheckoutConfigurationAvailable %}
        {# Scripts do not run in the dynamically loaded off-canvas, the plugin loads Adyen Web itself when needed #}
        {% sw_include '@AdyenPaymentShopware6/storefront/component/checkout/expresscheckout.html.twig' with { adyenExpressCheckoutPage: 'offcanvas' } %}
    {% endif %}
{% endblock %}
