{# adyenExpressCheckoutPage: storefront location of this block - product, cart or offcanvas #}
{% set adyenExpressCheckoutPage = adyenExpressCheckoutPage ?? 'product' %}
{# The off-canvas cart can be opened on a page that already renders express checkout, so its ids must differ #}
{% set adyenExpressCheckoutIdSuffix = adyenExpressCheckoutPage == 'offcanvas' ? '-offcanvas' : '' %}
<div id="adyen-express-checkout{{ adyenExpressCheckoutIdSuffix }}"
     class="adyen-express-checkout adyen-express-checkout--{{ adyenExpressCheckoutPage|escape }}"
     data-adyen-express-checkout
     data-page="{{ adyenExpressCheckoutPage|escape }}"
     data-locale="{{ adyenFrontendData.locale }}"
     data-client-key="{{ adyenFrontendData.clientKey }}"
     data-environment="{{ adyenFrontendData.environment }}"
     data-adyen-web-script-url="{{ asset('bundles/adyenpaymentshopware6/js/adyen.js', 'asset') }}"
     data-adyen-web-style-url="{{ asset('bundles/adyenpaymentshopware6/css/adyen.css', 'asset') }}"
     {% if app.request.attributes.get('_cspNonce') %}data-csp-nonce="{{ app.request.attributes.get('_cspNonce') }}"{% endif %}
>
    <div class="adyen-express-checkout-options"
         data-adyen-express-checkout-options
         data-payment-status-url="{{ adyenFrontendData.paymentStatusUrl }}"
         data-checkout-order-url="{{ adyenFrontendData.checkoutOrderUrl }}"
         data-checkout-order-express-url="{{ adyenFrontendData.checkoutOrderExpressUrl }}"
         data-express-checkout-config-url="{{ adyenFrontendData.expressCheckoutConfigUrl }}"
         data-payment-handle-url="{{ adyenFrontendData.paymentHandleUrl }}"
         data-payment-handle-express-url="{{ adyenFrontendData.paymentHandleExpressUrl }}"
         data-payment-details-url="{{ adyenFrontendData.paymentDetailsUrl }}"
         data-payment-finish-url="{{ adyenFrontendData.paymentFinishUrl }}"
         data-payment-error-url="{{ adyenFrontendData.paymentErrorUrl }}"
         data-express-checkout-update-paypal-order-url="{{ adyenFrontendData.expressCheckoutUpdatePaypalOrderUrl }}"
         data-country-code="{{ adyenFrontendData.countryCode }}"
         data-amount="{{ adyenFrontendData.amount }}"
         data-currency="{{ adyenFrontendData.currency }}"
         data-payment-methods-response="{{ adyenFrontendData.paymentMethodsResponse }}"
         data-user-logged-in="{{ adyenFrontendData.userLoggedIn }}"
         data-affiliate-code="{{ adyenFrontendData.affiliateCode }}"
         data-campaign-code="{{ adyenFrontendData.campaignCode }}"
         data-google-merchant-id="{{ adyenFrontendData.googleMerchantId }}"
         data-gateway-merchant-id="{{ adyenFrontendData.gatewayMerchantId }}"
         data-googlepay-button-type="{{ adyenFrontendData.googlePayButtonType }}"
         data-googlepay-button-color="{{ adyenFrontendData.googlePayButtonColor }}"
         data-googlepay-button-size="{{ adyenFrontendData.googlePayButtonSize }}"
         data-paypal-button-color="{{ adyenFrontendData.paypalButtonColor }}"
         data-paypal-button-shape="{{ adyenFrontendData.paypalButtonShape }}"
         data-paypal-button-label="{{ adyenFrontendData.paypalButtonLabel }}"
         data-paypal-button-installments-mexico="{{ adyenFrontendData.paypalButtonInstallmentsMX }}"
         data-paypal-button-installments-brazil="{{ adyenFrontendData.paypalButtonInstallmentsBR }}"
         data-applepay-button-type="{{ adyenFrontendData.applePayButtonType }}"
         data-applepay-button-color="{{ adyenFrontendData.applePayButtonColor }}"
         data-paypal-express-order-finalize-url="{{ adyenFrontendData.paypalExpressOrderFinalizeUrl }}"
         data-paypal-express-order-url="{{ adyenFrontendData.paypalExpressOrderUrl }}"
    ></div>
    {% set adyenExpressCheckoutPaymentTypes = ['applepay', 'googlepay', 'paywithgoogle', 'paypal'] %}
    {% for adyenPaymentMethodType in adyenExpressCheckoutPaymentTypes %}
        <div class="adyen-express-checkout-element"
             id="adyen-express-checkout-{{ adyenPaymentMethodType|escape }}{{ adyenExpressCheckoutIdSuffix }}">
            <input type="hidden" class="adyen-type" name="adyen-type"
                   value="{{ adyenPaymentMethodType|escape }}">
        </div>
    {% endfor %}
    {% sw_include '@AdyenPaymentShopware6/storefront/component/payment/payment-action-modal.html.twig' with {
        adyenPaymentActionModalId: 'adyen-payment-action-modal' ~ adyenExpressCheckoutIdSuffix
    } %}
</div>
